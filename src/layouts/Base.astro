---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import { UI, otherLang, type ColumnKey, type Lang } from '../i18n/ui';
import { LAUNCHED } from '../site';
import '../styles/global.css';
import serifLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import serifExtended from '@fontsource-variable/fraunces/files/fraunces-latin-ext-opsz-normal.woff2?url';
import sansLatin from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import sansExtended from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-ext-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** A jelenlegi oldal megfelelője a másik nyelven (nyelvváltó + hreflang). */
  altUrl: string;
  active?: ColumnKey | 'about' | 'workshop' | 'calendar';
  /** A nyelvváltó fallbackje nem feltétlenül az oldal fordítása. */
  hasTranslation?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  socialImage?: { src: string; width: number; height: number; alt: string };
}

const { lang, title, description, altUrl, active, hasTranslation = true,
  noindex = false, ogType = 'website', socialImage } = Astro.props;
const t = UI[lang];

const pageTitle = title ? `${title} | Lume` : t.siteTitle;
const pageDescription = description ?? t.siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(altUrl, Astro.site);
const ogImage = new URL(socialImage?.src ?? '/og-image.png', Astro.site);
const indexable = LAUNCHED && !noindex;
const organizationId = new URL('/#organization', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const siteStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Lume',
      url: new URL('/', Astro.site).href,
      description: t.siteDescription,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/apple-touch-icon.png', Astro.site).href,
        width: 180,
        height: 180,
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Lume',
      alternateName: 'Lume Journal',
      url: new URL('/', Astro.site).href,
      inLanguage: ['hu-HU', 'en-GB'],
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {[serifLatin, sansLatin, ...(lang === 'hu' ? [serifExtended, sansExtended] : [])].map((font) => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    ))}
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {/* Amíg nincs domain és első cikk, ne indexelje senki. Kapcsoló: src/site.ts */}
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    {indexable && <link rel="canonical" href={canonical} />}
    {indexable && hasTranslation && <>
      <link rel="alternate" hreflang={lang} href={canonical} />
      <link rel="alternate" hreflang={otherLang(lang)} href={alternate} />
      <link rel="alternate" hreflang="x-default" href={lang === 'hu' ? canonical : alternate} />
    </>}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Lume" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_GB'} />
    {hasTranslation && <meta property="og:locale:alternate" content={lang === 'hu' ? 'en_GB' : 'hu_HU'} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={socialImage?.width ?? 1200} />
    <meta property="og:image:height" content={socialImage?.height ?? 630} />
    <meta property="og:image:alt" content={socialImage?.alt ?? t.tagline} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialImage?.alt ?? t.tagline} />

    <StructuredData data={siteStructuredData} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      /* A böngésző státuszsávja már az első kirajzoláskor a Lume mentett
         színmódját kapja, nem a telefon ettől független rendszerbeállítását. */
      (function () {
        var root = document.documentElement;
        var lightColor = '#E6DAC1';
        var darkColor = '#13100B';
        var savedDark = false;
        var appleTouch = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
          (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

        try {
          savedDark = localStorage.getItem('lume-theme') === 'dark';
        } catch (e) {
          /* Letiltott helyi tárolásnál a világos mód az alapértelmezett. */
        }

        var initialColor = savedDark ? darkColor : lightColor;
        root.dataset.themeColorLight = lightColor;
        root.dataset.themeColorDark = darkColor;
        root.dataset.appleTouch = appleTouch ? 'true' : 'false';
        root.classList.toggle('dark', savedDark);
        root.style.colorScheme = savedDark ? 'dark' : 'light';
        root.style.backgroundColor = initialColor;

        /* Az iOS 26 Safari a lap hátteréből veszi a státuszsáv színét, és a
           theme-color dinamikus módosítását nem mindig rajzolja újra. Androidon
           továbbra is a szabványos metaelem ad megbízható eredményt. */
        if (!appleTouch) {
          var themeColor = document.createElement('meta');
          themeColor.id = 'themeColor';
          themeColor.name = 'theme-color';
          themeColor.content = initialColor;
          document.head.appendChild(themeColor);
        }
      })();
    </script>

    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.siteTitle}
      href={lang === 'hu' ? '/rss.xml' : '/en/rss.xml'}
    />

    <slot name="head" />
  </head>

  <body>
    <script is:inline>
      /* A mentett fényállapotot még a tartalom kirajzolása előtt állítsuk vissza. */
      try {
        if (localStorage.getItem('lume-theme') === 'dark') {
          document.body.classList.add('dark');
        }
      } catch (e) {
        /* A böngésző letilthatja a helyi tárolást — ilyenkor marad a világos nézet. */
      }
      document.body.style.backgroundColor = document.documentElement.style.backgroundColor;
    </script>
    <a class="skip-link" href="#top">{t.skipToContent}</a>
    <Header lang={lang} altUrl={altUrl} active={active} />
    <main id="top">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline src="/widgets/frame-bridge.js"></script>

    <script define:vars={{ labels: { on: t.lightsOff, off: t.lightsOn, heroOn: t.heroLightsOff, heroOff: t.heroLightsOn } }}>
      /* „Lámpa le" — az egyetlen bátor elem. A választás oldalváltás és
         újratöltés után is megmarad ebben a böngészőben. */
      (function () {
        var body = document.body;
        var lightsBtn = document.getElementById('lightsBtn');
        var lightsLbl = document.getElementById('lightsLabel');
        var heroBtn = document.getElementById('heroLights');
        var heroLbl = document.getElementById('heroLightsLabel');
        var themeColor = document.getElementById('themeColor');
        var root = document.documentElement;
        var appleTouch = root.dataset.appleTouch === 'true';
        var themeKey = 'lume-theme';
        var lights = body.classList.contains('dark') ? 'off' : 'on';
        var hinted = false;

        if (!lightsBtn) return;
        var modelFrames = window.LumeFrames.bindParent(function () { return lights === 'off'; });

        function render() {
          var isDark = lights === 'off';
          var chromeColor = isDark ? root.dataset.themeColorDark : root.dataset.themeColorLight;
          if (lightsLbl) lightsLbl.textContent = lights === 'on' ? labels.on : labels.off;
          if (heroLbl) heroLbl.textContent = lights === 'on' ? labels.heroOn : labels.heroOff;
          lightsBtn.setAttribute('aria-pressed', String(isDark));
          root.classList.toggle('dark', isDark);
          root.style.colorScheme = isDark ? 'dark' : 'light';
          root.style.backgroundColor = chromeColor;
          body.style.backgroundColor = chromeColor;

          if (appleTouch) {
            /* WebKit a dokumentum hátterét figyeli; régi, gyorsítótárazott metaelem
               se maradjon a fában, amely világos színt kényszeríthetne rá. */
            if (themeColor) themeColor.remove();
            themeColor = null;
          } else {
            /* Androidon egy új metaelem létrehozása a váltást is azonnal jelzi a
               böngésző felületének, nem csak a DOM-ban írja át a régi értéket. */
            var nextThemeColor = document.createElement('meta');
            nextThemeColor.id = 'themeColor';
            nextThemeColor.name = 'theme-color';
            nextThemeColor.content = chromeColor;
            if (themeColor) themeColor.replaceWith(nextThemeColor);
            else document.head.appendChild(nextThemeColor);
            themeColor = nextThemeColor;
          }
          document.documentElement.style.setProperty('--hint', hinted ? '0' : '1');
        }

        /* A cikkbe ágyazott modellek (iframe) is kövessék a lámpát. */
        function tellFrames() {
          modelFrames.broadcast();
        }

        function toggleLights() {
          lights = lights === 'on' ? 'off' : 'on';
          hinted = true;
          body.classList.toggle('dark', lights === 'off');
          try {
            localStorage.setItem(themeKey, lights === 'off' ? 'dark' : 'light');
          } catch (e) {
            /* A téma ettől még működik az aktuális oldalon. */
          }
          render();
          tellFrames();
        }

        lightsBtn.addEventListener('click', toggleLights);
        if (heroBtn) heroBtn.addEventListener('click', toggleLights);

        /* Ha egy másik böngészőfülben vált témát, ez az oldal is kövesse. */
        window.addEventListener('storage', function (event) {
          if (event.key !== themeKey) return;
          lights = event.newValue === 'dark' ? 'off' : 'on';
          body.classList.toggle('dark', lights === 'off');
          render();
          tellFrames();
        });

        render();
      })();
    </script>
  </body>
</html>
