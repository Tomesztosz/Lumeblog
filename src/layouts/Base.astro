---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JournalHead from '../components/JournalHead.astro';
import type { SeoHeadProps } from '../lib/seo';
import { UI } from '../i18n/ui';
import '../styles/global.css';

interface Props extends SeoHeadProps {}

const { lang, altUrl, active } = Astro.props;
const t = UI[lang];


---

<!doctype html>
<html lang={lang}>
  <head>
    <JournalHead {...Astro.props}><slot name="head" /></JournalHead>
    <script is:inline>
      /* A böngésző státuszsávja már az első kirajzoláskor a Lume mentett
         színmódját kapja, nem a telefon ettől független rendszerbeállítását. */
      (function () {
        var root = document.documentElement;
        var lightColor = '#E6DAC1';
        var darkColor = '#13100B';
        var savedDark = false;
        var appleTouch = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
          (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

        try {
          savedDark = localStorage.getItem('lume-theme') === 'dark';
        } catch (e) {
          /* Letiltott helyi tárolásnál a világos mód az alapértelmezett. */
        }

        var initialColor = savedDark ? darkColor : lightColor;
        root.dataset.themeColorLight = lightColor;
        root.dataset.themeColorDark = darkColor;
        root.dataset.appleTouch = appleTouch ? 'true' : 'false';
        root.classList.toggle('dark', savedDark);
        root.style.colorScheme = savedDark ? 'dark' : 'light';
        root.style.backgroundColor = initialColor;

        /* Az iOS 26 Safari a lap hátteréből veszi a státuszsáv színét, és a
           theme-color dinamikus módosítását nem mindig rajzolja újra. Androidon
           továbbra is a szabványos metaelem ad megbízható eredményt. */
        if (!appleTouch) {
          var themeColor = document.createElement('meta');
          themeColor.id = 'themeColor';
          themeColor.name = 'theme-color';
          themeColor.content = initialColor;
          document.head.appendChild(themeColor);
        }
      })();
    </script>


  </head>

  <body>
    <script is:inline>
      /* A mentett fényállapotot még a tartalom kirajzolása előtt állítsuk vissza. */
      try {
        if (localStorage.getItem('lume-theme') === 'dark') {
          document.body.classList.add('dark');
        }
      } catch (e) {
        /* A böngésző letilthatja a helyi tárolást — ilyenkor marad a világos nézet. */
      }
      document.body.style.backgroundColor = document.documentElement.style.backgroundColor;
    </script>
    <a class="skip-link" href="#top">{t.skipToContent}</a>
    <Header lang={lang} altUrl={altUrl} active={active} />
    <main id="top">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline src="/widgets/frame-bridge.js"></script>

    <script define:vars={{ labels: { on: t.lightsOff, off: t.lightsOn, heroOn: t.heroLightsOff, heroOff: t.heroLightsOn } }}>
      /* „Lámpa le" — az egyetlen bátor elem. A választás oldalváltás és
         újratöltés után is megmarad ebben a böngészőben. */
      (function () {
        var body = document.body;
        var lightsBtn = document.getElementById('lightsBtn');
        var lightsLbl = document.getElementById('lightsLabel');
        var heroBtn = document.getElementById('heroLights');
        var heroLbl = document.getElementById('heroLightsLabel');
        var themeColor = document.getElementById('themeColor');
        var root = document.documentElement;
        var appleTouch = root.dataset.appleTouch === 'true';
        var themeKey = 'lume-theme';
        var lights = body.classList.contains('dark') ? 'off' : 'on';
        var hinted = false;

        if (!lightsBtn) return;
        var modelFrames = window.LumeFrames.bindParent(function () { return lights === 'off'; });

        function render() {
          var isDark = lights === 'off';
          var chromeColor = isDark ? root.dataset.themeColorDark : root.dataset.themeColorLight;
          if (lightsLbl) lightsLbl.textContent = lights === 'on' ? labels.on : labels.off;
          if (heroLbl) heroLbl.textContent = lights === 'on' ? labels.heroOn : labels.heroOff;
          lightsBtn.setAttribute('aria-pressed', String(isDark));
          root.classList.toggle('dark', isDark);
          root.style.colorScheme = isDark ? 'dark' : 'light';
          root.style.backgroundColor = chromeColor;
          body.style.backgroundColor = chromeColor;

          if (appleTouch) {
            /* WebKit a dokumentum hátterét figyeli; régi, gyorsítótárazott metaelem
               se maradjon a fában, amely világos színt kényszeríthetne rá. */
            if (themeColor) themeColor.remove();
            themeColor = null;
          } else {
            /* Androidon egy új metaelem létrehozása a váltást is azonnal jelzi a
               böngésző felületének, nem csak a DOM-ban írja át a régi értéket. */
            var nextThemeColor = document.createElement('meta');
            nextThemeColor.id = 'themeColor';
            nextThemeColor.name = 'theme-color';
            nextThemeColor.content = chromeColor;
            if (themeColor) themeColor.replaceWith(nextThemeColor);
            else document.head.appendChild(nextThemeColor);
            themeColor = nextThemeColor;
          }
          document.documentElement.style.setProperty('--hint', hinted ? '0' : '1');
        }

        /* A cikkbe ágyazott modellek (iframe) is kövessék a lámpát. */
        function tellFrames() {
          modelFrames.broadcast();
        }

        function toggleLights() {
          lights = lights === 'on' ? 'off' : 'on';
          hinted = true;
          body.classList.toggle('dark', lights === 'off');
          try {
            localStorage.setItem(themeKey, lights === 'off' ? 'dark' : 'light');
          } catch (e) {
            /* A téma ettől még működik az aktuális oldalon. */
          }
          render();
          tellFrames();
        }

        lightsBtn.addEventListener('click', toggleLights);
        if (heroBtn) heroBtn.addEventListener('click', toggleLights);

        /* Ha egy másik böngészőfülben vált témát, ez az oldal is kövesse. */
        window.addEventListener('storage', function (event) {
          if (event.key !== themeKey) return;
          lights = event.newValue === 'dark' ? 'off' : 'on';
          body.classList.toggle('dark', lights === 'off');
          render();
          tellFrames();
        });

        render();
      })();
    </script>
  </body>
</html>
