---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import { UI, otherLang, type ColumnKey, type Lang } from '../i18n/ui';
import { LAUNCHED } from '../site';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** A jelenlegi oldal megfelelője a másik nyelven (nyelvváltó + hreflang). */
  altUrl: string;
  active?: ColumnKey | 'about' | 'workshop';
}

const { lang, title, description, altUrl, active } = Astro.props;
const t = UI[lang];

const pageTitle = title ? `${title} — Lume` : t.siteTitle;
const pageDescription = description ?? t.siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(altUrl, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const organizationId = new URL('/#organization', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const siteStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Lume',
      url: new URL('/', Astro.site).href,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/apple-touch-icon.png', Astro.site).href,
        width: 180,
        height: 180,
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Lume',
      alternateName: 'Lume Journal',
      url: new URL('/', Astro.site).href,
      inLanguage: ['hu-HU', 'en-GB'],
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {/* Amíg nincs domain és első cikk, ne indexelje senki. Kapcsoló: src/site.ts */}
    {!LAUNCHED && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang(lang)} href={alternate} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_GB'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <StructuredData data={siteStructuredData} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#E6DAC1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13100B" media="(prefers-color-scheme: dark)" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.siteTitle}
      href={lang === 'hu' ? '/rss.xml' : '/en/rss.xml'}
    />

    <slot name="head" />
  </head>

  <body>
    <script is:inline>
      /* A mentett fényállapotot még a tartalom kirajzolása előtt állítsuk vissza. */
      try {
        if (localStorage.getItem('lume-theme') === 'dark') {
          document.body.classList.add('dark');
        }
      } catch (e) {
        /* A böngésző letilthatja a helyi tárolást — ilyenkor marad a világos nézet. */
      }
    </script>
    <a class="skip-link" href="#top">{t.skipToContent}</a>
    <Header lang={lang} altUrl={altUrl} active={active} />
    <main id="top">
      <slot />
    </main>
    <Footer lang={lang} />

    <script define:vars={{ labels: { on: t.lightsOff, off: t.lightsOn, heroOn: t.heroLightsOff, heroOff: t.heroLightsOn } }}>
      /* „Lámpa le" — az egyetlen bátor elem. A választás oldalváltás és
         újratöltés után is megmarad ebben a böngészőben. */
      (function () {
        var body = document.body;
        var lightsBtn = document.getElementById('lightsBtn');
        var lightsLbl = document.getElementById('lightsLabel');
        var heroBtn = document.getElementById('heroLights');
        var heroLbl = document.getElementById('heroLightsLabel');
        var themeKey = 'lume-theme';
        var lights = body.classList.contains('dark') ? 'off' : 'on';
        var hinted = false;

        if (!lightsBtn) return;

        function render() {
          if (lightsLbl) lightsLbl.textContent = lights === 'on' ? labels.on : labels.off;
          if (heroLbl) heroLbl.textContent = lights === 'on' ? labels.heroOn : labels.heroOff;
          lightsBtn.setAttribute('aria-pressed', String(lights === 'off'));
          document.documentElement.style.setProperty('--hint', hinted ? '0' : '1');
        }

        /* A cikkbe ágyazott modellek (iframe) is kövessék a lámpát. */
        function tellFrames() {
          var frames = document.querySelectorAll('iframe');
          for (var i = 0; i < frames.length; i++) {
            try {
              frames[i].contentWindow.postMessage(
                { type: 'lume:lights', dark: lights === 'off' },
                '*'
              );
            } catch (e) {
              /* más eredetű keret — nem a mienk, hagyjuk */
            }
          }
        }

        function toggleLights() {
          lights = lights === 'on' ? 'off' : 'on';
          hinted = true;
          body.classList.toggle('dark', lights === 'off');
          try {
            localStorage.setItem(themeKey, lights === 'off' ? 'dark' : 'light');
          } catch (e) {
            /* A téma ettől még működik az aktuális oldalon. */
          }
          render();
          tellFrames();
        }

        lightsBtn.addEventListener('click', toggleLights);
        if (heroBtn) heroBtn.addEventListener('click', toggleLights);

        window.addEventListener('message', function (event) {
          if (!event.data) return;
          /* A keret jelzi, hogy betöltött — küldjük neki a jelenlegi állapotot. */
          if (event.data.type === 'lume:ready') tellFrames();
          /* A keret megmondja, mekkora — így nincs belső görgetősáv. */
          if (event.data.type === 'lume:height' && event.data.height > 0) {
            var frames = document.querySelectorAll('iframe');
            for (var i = 0; i < frames.length; i++) {
              if (frames[i].contentWindow === event.source) {
                frames[i].style.height = event.data.height + 'px';
              }
            }
          }
        });

        /* Ha egy másik böngészőfülben vált témát, ez az oldal is kövesse. */
        window.addEventListener('storage', function (event) {
          if (event.key !== themeKey) return;
          lights = event.newValue === 'dark' ? 'off' : 'on';
          body.classList.toggle('dark', lights === 'off');
          render();
          tellFrames();
        });

        render();
      })();
    </script>
  </body>
</html>
