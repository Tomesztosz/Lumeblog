---
/* Élő számlap: az indexeket build-időben rajzoljuk ki,
   a mutatókat a böngésző állítja a valós helyi időre. */
import { UI, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const indices = Array.from({ length: 12 }, (_, i) => {
  const major = i % 3 === 0;
  const w = major ? 9 : 5;
  const h = major ? 26 : 18;
  return { x: 200 - w / 2, w, h, rot: i * 30 };
});
---

<svg class="dial" viewBox="0 0 400 400" role="img" aria-label={UI[lang].dialAlt}>
  <circle class="case-ring" cx="200" cy="200" r="192" stroke-width="7"></circle>
  <circle class="case-ring-in" cx="200" cy="200" r="180" stroke-width="1.5"></circle>
  <circle class="dial-face" cx="200" cy="200" r="176"></circle>

  <g id="indices">
    {
      indices.map((ix) => (
        <rect
          class="index"
          x={ix.x}
          y={40}
          width={ix.w}
          height={ix.h}
          rx={ix.w / 2}
          transform={`rotate(${ix.rot} 200 200)`}
        />
      ))
    }
  </g>

  <text class="dial-word" x="200" y="132" text-anchor="middle" font-size="17">LUME</text>
  <text class="dial-est" x="200" y="286" text-anchor="middle" font-size="9">EST. MMXXVI</text>

  <rect class="hand-lume" id="hourHand" x="196" y="112" width="8" height="98" rx="4"></rect>
  <rect class="hand-lume" id="minHand" x="197.5" y="66" width="5" height="146" rx="2.5"></rect>
  <g class="seconds" id="secHand">
    <rect x="199" y="70" width="2" height="150" rx="1"></rect>
    <rect x="197" y="212" width="6" height="26" rx="1"></rect>
  </g>
  <circle class="cap" cx="200" cy="200" r="7"></circle>
</svg>

<script>
  /* élő óra — a mutatók mindig az aktuális helyi időt mutatják */
  const hourHand = document.getElementById('hourHand');
  const minHand = document.getElementById('minHand');
  const secHand = document.getElementById('secHand');

  if (hourHand && minHand && secHand) {
    const setHands = () => {
      const now = new Date();
      const ms = now.getMilliseconds();
      const s = now.getSeconds();
      const m = now.getMinutes();
      const h = now.getHours() % 12;
      const secAngle = (s + ms / 1000) * 6; /* 6° per second */
      const minAngle = (m + s / 60) * 6; /* 6° per minute, drifts with seconds */
      const hourAngle = (h + m / 60) * 30; /* 30° per hour, drifts with minutes */
      hourHand.setAttribute('transform', `rotate(${hourAngle} 200 200)`);
      minHand.setAttribute('transform', `rotate(${minAngle} 200 200)`);
      secHand.setAttribute('transform', `rotate(${secAngle} 200 200)`);
    };

    const reduceMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      setHands();
      setInterval(setHands, 1000); /* másodpercenként lép, nincs folyamatos sweep */
    } else {
      const tick = () => {
        setHands();
        requestAnimationFrame(tick);
      };
      tick();
    }
  }
</script>
