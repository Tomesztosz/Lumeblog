---
import { UI, DESIGN_STUDY, type Lang } from "../../i18n/ui";
import type { ModelPost, Post } from "../../lib/posts";
import DesignModel from "./DesignModel.astro";
import { publicModelPosts, sharedModel } from '../../lib/shared-models';
import { urlOf } from '../../lib/posts';
import ModelShare from '../ModelShare.astro';
import JumpingSecondsModel from '../JumpingSecondsModel.astro';
interface Props {
  lang: Lang;
  posts: Post[];
}
const { lang, posts } = Astro.props;
const t = UI[lang];
const models = publicModelPosts(posts);
---

<section class="journal-workshop">
  <header class="journal-page-head">
    <p class="eyebrow">{t.workshopEyebrow}</p>
    <h1>{t.workshopTitle}</h1>
    <p>{t.workshopLede}</p>
    <div class="workshop-facts">
      <span>{t.workshopCount(models.length)}</span>
      <span>{DESIGN_STUDY[lang].modelHint}</span>
    </div>
  </header>
  <div class="workshop-list">
    {models.length ? (
      models.map((post, index) => post.data.model ? (
        <DesignModel post={post as ModelPost} index={index} featured={index === 0} />
      ) : (
        <article class="workshop-model" id={post.data.translationKey}>
          <div class="workshop-model-copy"><h2>{sharedModel(post)!.title}</h2><p>{sharedModel(post)!.description}</p><a class="workshop-read" href={urlOf(post)}>{t.workshopRead} →</a><ModelShare lang={lang} url={sharedModel(post)!.url} title={sharedModel(post)!.title} showPageLink /></div>
          <JumpingSecondsModel lang={lang} />
        </article>
      ))
    ) : (
      <p class="journal-empty">{t.workshopNoModels}</p>
    )}
  </div>
</section>
