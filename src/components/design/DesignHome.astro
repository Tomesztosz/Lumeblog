---
import { DESIGN_STUDY, COLUMNS, formatDate, type Lang, type ColumnKey } from '../../i18n/ui';
import { getPosts, minutesOf, type ModelPost } from '../../lib/posts';
import { homeFeed } from '../../lib/published-feed.mjs';
import { publicModelPosts, sharedModel } from '../../lib/shared-models';
import { journalLinks } from '../../lib/design';
import DesignMedia from './DesignMedia.astro';
import DesignModel from './DesignModel.astro';
import ModelShare from '../ModelShare.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = DESIGN_STUDY[lang];
const { designPost, designColumn, designArchive, designWorkshop } = journalLinks(Astro.locals.lumePreview === true);
const posts = await getPosts(lang);
const { featured, stories } = homeFeed(posts);
const latestModel = publicModelPosts(posts)[0];
const model = latestModel && sharedModel(latestModel);
---
{featured ? <section class="cover-story cover-story-current" data-home-feature={featured.data.translationKey}>
  <div class="cover-copy">
    <p class="eyebrow"><span class="index-dot"></span>{t.feature}</p>
    <div>
      <p class="brand-name">{COLUMNS[featured.data.column][lang].name} / <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date, lang)}</time></p>
      <h1>{featured.data.title}</h1>
    </div>
    <p class="cover-summary">{featured.data.description}</p>
    <a class="read-link" href={designPost(featured)}>{t.read}<span aria-hidden="true">↗</span></a>
    <div class="cover-bottom"><span>01 / {COLUMNS[featured.data.column][lang].name}</span><span>{minutesOf(featured)} {t.minutes}</span></div>
  </div>
  <DesignMedia post={featured} lead articleCover />
</section> : <section class="journal-page-head"><h1>{t.motto}</h1></section>}
{stories.length > 0 && <section class="selection" aria-labelledby="selection-title">
  <div class="section-title">
    <div><p class="eyebrow">LUME / JOURNAL</p><h2 id="selection-title">{t.selection}</h2></div>
    <p>{t.selectionText}</p>
    <a href={designArchive(lang)}>{t.archive} ↗</a>
  </div>
  <div class="story-grid">
    {stories.map((post, index) => <article class:list={['story', 'story-' + (index + 1)]} data-home-story={post.data.translationKey}>
      <DesignMedia post={post} href={designPost(post)} />
      <div class="journal-card-meta"><span>0{index + 2} / {COLUMNS[post.data.column][lang].name}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time></div>
      <h3><a href={designPost(post)}>{post.data.title}<span aria-hidden="true">↗</span></a></h3>
      <p>{post.data.description}</p>
    </article>)}
  </div>
</section>}
{latestModel && model && <section class="home-workshop">
  <div class="section-title"><div><p class="eyebrow">{t.workshop}</p><h2>{t.workshopNav}</h2></div><a href={designWorkshop(lang)}>{t.workshopNav} ↗</a></div>
  {model.kind === 'frame' ? <DesignModel post={latestModel as ModelPost} variant="spotlight" /> : <div><h3>{model.title}</h3><p>{model.description}</p><ModelShare lang={lang} title={model.title} url={model.url} showPageLink /></div>}
</section>}
<section class="directions">
  <div><p class="eyebrow">INDEX / LUME</p><h2>{t.browse}</h2><p>{t.browseText}</p></div>
  <ol>{t.routes.map((route, index) => <li><a href={designColumn(lang, route.column as ColumnKey)}><span class="route-number">0{index + 1}</span><div><h3>{route.label}</h3><p>{route.note}</p></div><span aria-hidden="true">↗</span></a></li>)}</ol>
</section>
