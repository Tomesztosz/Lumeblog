---
import { SHARED_MODEL_UI, CONTENT_LINKS, MODEL_READING_GUIDES, workshopUrl } from '../../i18n/ui';
import { urlOf, type Post, type ModelPost } from '../../lib/posts';
import { sharedModel } from '../../lib/shared-models';
import DesignModel from './DesignModel.astro';
import JumpingSecondsModel from '../JumpingSecondsModel.astro';
import RattrapanteModel from '../RattrapanteModel.astro';
import CoaxialModel from '../CoaxialModel.astro';
import ConstantEscapementModel from '../ConstantEscapementModel.astro';
import TourbillonModel from '../TourbillonModel.astro';
import ModelShare from '../ModelShare.astro';
import ContentConnections from './ContentConnections.astro';
interface Props { post: Post }
const { post } = Astro.props;
const lang = post.data.lang, t = SHARED_MODEL_UI[lang], model = sharedModel(post)!;
const guide = MODEL_READING_GUIDES[model.key as keyof typeof MODEL_READING_GUIDES]?.[lang], links=CONTENT_LINKS[lang];
---
<article class="shared-model-page" data-shared-model-page={model.key}>
  <header class="journal-page-head">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{model.title}</h1>
    <p>{model.description}</p>
    <ModelShare lang={lang} url={model.url} title={model.title} />
  </header>
  <div class="shared-model-stage">
    {model.kind === 'frame' ? <DesignModel post={post as ModelPost} variant="standalone" /> : model.key === 'constant-escapement' ? <ConstantEscapementModel lang={lang} standalone /> : model.key === 'tourbillon' ? <TourbillonModel lang={lang} standalone /> : model.key === 'co-axial' ? <CoaxialModel lang={lang} /> : model.key === 'rattrapante' ? <RattrapanteModel lang={lang} /> : <JumpingSecondsModel lang={lang} />}
  </div>
  <p class="shared-model-note">{t.note}</p>
  {guide && <section class="shared-model-reading" data-model-reading-guide>
    <h2>{guide.question}</h2>
    <h3>{links.observe}</h3><p>{guide.observe}</p>
    <h3>{links.limitation}</h3><p>{guide.limitation}</p>
  </section>}
  <ContentConnections post={post} modelPage />
  <section class="shared-model-reading">
    <p class="eyebrow">{t.fullStory}</p>
    <h2><a href={urlOf(post)}>{post.data.title} ↗</a></h2>
    <p>{t.fullStoryNote}</p>
    <a href={workshopUrl(lang)}>{t.allModels} ↗</a>
  </section>
  {post.data.cover && <p class="shared-model-credit">{t.imageCredit}: {post.data.cover.creditUrl ? <a href={post.data.cover.creditUrl} target="_blank" rel="noopener noreferrer">{post.data.cover.credit}</a> : post.data.cover.credit}{post.data.cover.license && <> · {post.data.cover.licenseUrl ? <a href={post.data.cover.licenseUrl} rel="license noopener noreferrer" target="_blank">{post.data.cover.license}</a> : post.data.cover.license}</>}</p>}
</article>
