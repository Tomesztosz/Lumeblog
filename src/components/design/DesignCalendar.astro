---
import type { Lang } from "../../i18n/ui";
import noScriptStyles from '../../styles/calendar-noscript.css?url';
import {
  phaseFor,
  matchesCalendar,
  sortCalendar,
  calendarCounts,
  focusGroup,
  eventDateLabel,
  classifyCalendarEvent,
  statusLabel,
  needsSourceReview,
} from "../../lib/calendar-state.mjs";
import { downloadableEvent, exportableEvent } from '../../lib/calendar-ics.mjs';
import {
  brandRadar,
  CALENDAR_UI,
  calendarMeta,
  calendarRevision,
  releaseIcsUrl,
  releases,
  calendarEntries,
} from "../../lib/releases";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = CALENDAR_UI[lang];
const now = new Date();
const entries = sortCalendar(calendarEntries.filter(e => classifyCalendarEvent(e, now).public), now);
const counts = calendarCounts(entries, now);
const highlighted = focusGroup(entries, now);
const nextRelease = highlighted[0];
const views = [
  { key: 'active', label: t.viewActive },
  { key: 'announced', label: t.viewAnnounced },
  { key: 'archived', label: t.viewArchive },
  { key: 'review', label: t.viewReview },
];
const brands = brandRadar
  .map((brand) => [brand.key, brand.name])
  .sort((a, b) => a[1].localeCompare(b[1]));
const months = [
  ...new Set(entries.map((entry) => entry.lifecycle.schedule?.value?.slice(0, 7)).filter(value => /^\d{4}-\d{2}$/.test(value))),
].map((value) => [
  value,
  new Intl.DateTimeFormat(lang === "hu" ? "hu-HU" : "en-GB", {
    year: "numeric",
    month: "long",
    timeZone: "UTC",
  }).format(new Date(`${value}-01T00:00:00Z`)),
]);
const majorBrands = brandRadar.filter((brand) => brand.group === "major");
const independentBrands = brandRadar.filter(
  (brand) => brand.group === "independent",
);
const radarReviewDate = new Intl.DateTimeFormat(
  lang === "hu" ? "hu-HU" : "en-GB",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  },
).format(new Date(`${calendarMeta.lastReviewed}T00:00:00Z`));
const targetedReviewDate = calendarMeta.lastTargetedReview
  ? new Intl.DateTimeFormat(lang === 'hu' ? 'hu-HU' : 'en-GB', {
      dateStyle: 'long', timeZone: 'UTC',
    }).format(new Date(`${calendarMeta.lastTargetedReview}T00:00:00Z`))
  : null;

const clientCopy = {
  ...Object.fromEntries(Object.entries(t).filter(([, value]) => typeof value === 'string')),
  statusUpcoming: t.statusUpcoming,
  statusCurrent: t.statusCurrent,
  statusArchived: t.statusArchived,
  statusToday: t.statusToday,
  statusIntroduced: t.statusIntroduced,
  announced: t.announced,
  daysOne: t.daysOne,
  daysMany: t.clientDaysMany,
  resultsOne: t.clientResultsOne,
  resultsMany: t.clientResultsMany,
  noResults: t.noResults,
  noBrandResults: t.noBrandResults,
};
---

<div class="calendar-page">
  <section class="calendar-hero journal-page-head">
    <div class="wrap calendar-hero-grid">
      <div class="calendar-hero-copy">
        <p class="eyebrow mono">{t.eyebrow}</p>
        <h1>{t.title}</h1>
        <p class="lede">{t.lede}</p>
        <div class="calendar-hero-notes mono">
          <span>
            <i class="calendar-led" aria-hidden="true"></i>
            {t.curated}
          </span>
          <span>✓ {t.verified}</span>
        </div>
      </div>

      <div class="calendar-instrument">
        <div class="calendar-instrument-copy">
          <span class="mono">{t.next}</span>
          <strong data-calendar-focus-title>
            {highlighted.length > 1 ? t.focusGroup.replace('{n}', String(highlighted.length)) : nextRelease
              ? `${nextRelease.brand} ${nextRelease.family}`
              : t.focusEmpty}
          </strong>
          <small data-calendar-focus-date>{highlighted.length > 1 ? t.focusGroupDates : nextRelease ? eventDateLabel(nextRelease, lang, t) : ''}</small>
          <a data-calendar-focus-link href={nextRelease ? `#${nextRelease.id}` : '#calendar-list-title'} hidden={!nextRelease}>{t.focusOpen} ↗</a>
          <ul data-calendar-focus-group>{highlighted.length > 1 && highlighted.map(e => <li><a href={`#${e.id}`}>{e.brand} {e.family}</a></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section calendar-list" aria-labelledby="calendar-list-title">
    <div class="wrap">
      <div class="calendar-list-head">
        <div>
          <p class="eyebrow mono">{t.eyebrow}</p>
          <h2 id="calendar-list-title">{t.nav}</h2>
        </div>
        <p
          class="calendar-result-count mono"
          id="calendarResultCount"
          role="status"
          aria-live="polite"
        >
          {t.results(counts.active)}
        </p>
      </div>

      <p class="calendar-overview-help">{t.overviewHelp}</p>
      <div class="calendar-views calendar-interactive" aria-label={t.statusLabel}>
        {views.map(view => <button type="button" data-calendar-view={view.key} aria-pressed={view.key === 'active'}>
          <span>{view.label}</span><strong data-calendar-count={view.key}>{counts[view.key]}</strong>
        </button>)}
      </div>
      <p class="calendar-archive-help" data-calendar-archive-help hidden>{t.archiveHelp}</p>
      <div class="calendar-search">
        <label for="releaseQuery">{t.searchLabel}</label>
        <input id="releaseQuery" type="search" autocomplete="off" />
        <button id="releaseReset" type="button">
          {t.resetFilters}
        </button>
      </div>
      <div class="calendar-filters" aria-label={t.filters}>
        <label>
          <span class="mono">{t.statusLabel}</span>
          <select id="releaseStatusFilter">
            <option value="active">{t.activeStatuses}</option>
            <option value="announced">{t.announced}</option>
            <option value="all">{t.allStatuses}</option>
            <option value="archived">{t.archivedStatuses}</option>
            <option value="review">{t.viewReview}</option>
          </select>
        </label>
        <label>
          <span class="mono">{t.monthLabel}</span>
          <select id="releaseMonthFilter">
            <option value="all">{t.allMonths}</option>
            <option value="undated">{t.undated}</option>
            {months.map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
        </label>
        <label>
          <span class="mono">{t.brandLabel}</span>
          <select id="releaseBrandFilter">
            <option value="all">{t.allBrands}</option>
            {brands.map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
        </label>
      </div>

      <div class="calendar-grid" id="calendarGrid">
        {entries.map((release) => {
          const phase = phaseFor(release, now);
          const status = statusLabel(release, t, now);
          const edition = release.limitedPieces
            ? t.limited(release.limitedPieces)
            : t.unknownEdition;
          return (
            <article
              class="release-card"
              id={release.id}
              data-release-card
              data-precision={release.lifecycle.schedule.precision}
              data-brand={release.brandKey}
              data-phase={phase}
              hidden={!matchesCalendar(release, {}, now)}
            >
              <figure
                class="release-card-media"
                style={`--media-ratio: ${release.imageWidth / release.imageHeight}`}
              >
                <img
                  src={release.image}
                  alt={`${release.brand} ${release.family} ${release.model}`}
                  width={release.imageWidth}
                  height={release.imageHeight}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="mono">
                  {t.imageCredit}: {release.imageCredit}
                </figcaption>
              </figure>

              <div class="release-card-body">
                <div class="release-card-topline mono">
                  <span
                    class="release-status"
                    data-release-status
                    data-phase={phase}
                  >
                    <i aria-hidden="true"></i>
                    {status}
                  </span>
                  <span>{release.reference}</span>
                </div>

                <p class="release-brand mono">
                  {release.brand} · {release.family}
                </p>
                <h3>{release.model}</h3>
                <p class="release-summary">{release.copy[lang].summary}</p>

                <dl class="release-facts">
                  <div>
                    <dt class="mono">{t[`event_${release.lifecycle.identity.type}`]}</dt>
                    <dd>{eventDateLabel(release, lang, t)}</dd>
                  </div>
                  <div>
                    <dt class="mono">{t.edition}</dt>
                    <dd>{edition}</dd>
                  </div>
                  <div>
                    <dt class="mono">{t.availability}</dt>
                    <dd>{release.lifecycle.revision ? release.lifecycle.evidence.at(-1)?.quote : release.copy[lang].availability}</dd>
                  </div>
                  {release.price && (
                    <div>
                      <dt class="mono">{t.price}</dt>
                      <dd>{release.price}</dd>
                    </div>
                  )}
                </dl>

                <div class="release-selection">
                  <span class="mono">{t.selection}</span>
                  <p>{release.copy[lang].selection}</p>
                </div>

                <div class="release-card-actions">
                  <a href={release.sourceUrl} target="_blank" rel="noreferrer">
                    {t.officialSource} ↗
                  </a>
                  {exportableEvent(release) && (
                    <a href={releaseIcsUrl(release, lang)} download data-calendar-download hidden={!downloadableEvent(release, now)}>
                      {t.addCalendar} ↓
                    </a>
                  )}
                </div>
                <p class="release-precision mono">
                  {t.verified}: {release.lifecycle.semanticVerifiedAt ?? release.sourceChecked}
                </p>
                {!release.date && <p class="release-precision mono">{t.firstSeenLabel}: {release.firstSeen}</p>}
                <p class="release-source-aging" data-source-aging hidden={!needsSourceReview(release, now)}>{t.sourceAging}</p>
                {release.lifecycle.evidence.length > 0 && <p class="release-precision">{t.sourceClaim}: {release.lifecycle.evidence.at(-1).quote}</p>}
                {release.lifecycle.history.length > 0 && <details><summary>{t.historyTitle}</summary><ul>{release.lifecycle.history.map(h => <li>{h.changedAt}: {t.originalPlan}, {eventDateLabel({...release,lifecycle:{...release.lifecycle,sourceStatus:h.sourceStatus,schedule:h.schedule}},lang,t)}</li>)}</ul></details>}
              </div>
            </article>
          );
        })}
      </div>

      <p class="calendar-empty" id="calendarEmpty" hidden={counts.active > 0}>
        {t.noResults}
      </p>
      <p data-calendar-empty-help hidden={counts.active > 0}>{t.emptyHelp} <a href="?status=announced">{t.viewAnnounced}</a> · <a href="?status=archived">{t.viewArchive}</a></p>
    </div>
  </section>

  <section
    class="section calendar-radar"
    aria-labelledby="calendar-radar-title"
  >
    <div class="wrap">
      <div class="calendar-radar-head">
        <p class="eyebrow mono">{t.radarEyebrow}</p>
        <h2 id="calendar-radar-title">{t.radarTitle}</h2>
        <p class="calendar-radar-text">{t.radarText}</p>
        <p class="calendar-radar-reviewed mono">
          <i class="calendar-led" aria-hidden="true"></i>
          {t.radarLastChecked(radarReviewDate)}
        </p>
        {targetedReviewDate && <p class="calendar-radar-text" data-calendar-targeted-review>{t.radarTargetedChecked(targetedReviewDate)}</p>}
      </div>

      <div class="calendar-radar-groups">
        {[
          { title: t.radarMajor, brands: majorBrands },
          { title: t.radarIndependent, brands: independentBrands },
        ].map((group) => (
          <div class="calendar-radar-group">
            <h3 class="mono">{group.title}</h3>
            <div class="calendar-radar-grid">
              {group.brands.map((brand) => {
                const count = calendarEntries.filter(
                  (entry) => entry.brandKey === brand.key && matchesCalendar(entry, {}, now),
                ).length;
                const active = count > 0;
                return (
                  <a
                    href={brand.sourceUrl}
                    target="_blank"
                    rel="noreferrer"
                    class:list={["calendar-radar-brand", { active }]}
                    data-radar-brand={brand.key}
                  >
                    <span>
                      <i aria-hidden="true"></i>
                      <strong>{brand.name}</strong>
                    </span>
                    <small class="mono" data-radar-count>
                      {active ? t.radarCount(count) : t.radarWatched}
                    </small>
                    <small class="mono">
                      {t.radarSources(
                        1 + (brand.additionalSources?.length ?? 0),
                      )}
                    </small>
                    <em class="mono">{t.radarOfficial} ↗</em>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</div>

<div
  id="calendarData"
  hidden
  data-entries={JSON.stringify(entries)}
  data-copy={JSON.stringify(clientCopy)}
  data-lang={lang}
  data-revision={calendarRevision}
></div>
<noscript>
  <p class="wrap calendar-overview-help">{t.noScript}</p>
  <link rel="stylesheet" href={noScriptStyles} />
</noscript>
<script>
  import "../../lib/calendar-client";
</script>
