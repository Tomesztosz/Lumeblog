---
import MastheadClock from "./MastheadClock.astro";
import SiteIcons from "../SiteIcons.astro";
import { DESIGN_STUDY, COLUMNS, COLUMN_KEYS, type Lang } from "../../i18n/ui";
import { getPosts } from "../../lib/posts";
import JournalHead from "../JournalHead.astro";
import StructuredData from "../StructuredData.astro";
import type { JournalMetadata } from "../../lib/journal-metadata";
import { journalLinks, type DesignView } from "../../lib/design";
const {
  designHome,
  designPost,
  designColumn,
  designArchive,
  designCalendar,
  designWorkshop,
  designAbout,
} = journalLinks(Astro.locals.lumePreview === true);
import "../../styles/lume-next.css";
import "../../styles/lume-pages.css";
interface Props {
  lang: Lang;
  title: string;
  alternate: string;
  view: DesignView;
  active?: string;
  metadata?: JournalMetadata;
}
const { lang, title, alternate, view, active, metadata } = Astro.props;
const preview = Astro.locals.lumePreview === true;
const t = DESIGN_STUDY[lang];
const posts = (await getPosts(lang)).filter((p) => p.data.date <= new Date());
const home = designHome(lang);
const read = home + "read/";
---

<!doctype html>
<html lang={lang} data-preview={String(preview)}>
  <head>
    {metadata ? (
      <JournalHead lang={lang} {...metadata}>
        {"published" in metadata && (
          <meta
            property="article:published_time"
            content={metadata.published}
          />
        )}
        {"modified" in metadata && metadata.modified && (
          <meta property="article:modified_time" content={metadata.modified} />
        )}
        {"section" in metadata && (
          <meta property="article:section" content={metadata.section} />
        )}
        {"structuredData" in metadata && (
          <StructuredData data={metadata.structuredData} />
        )}
      </JournalHead>
    ) : (
      <>
        <meta charset="UTF-8" />
        <meta
          name="viewport"
          content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="robots" content="noindex,nofollow" />
        <title>{`${title} · Lume`}</title>
        <SiteIcons />
      </>
    )}
    <script is:inline>
      document.documentElement.dataset.js = "true";
      try {
        const preview = document.documentElement.dataset.preview === "true";
        if (
          preview
            ? sessionStorage.getItem("lume-design-dark") === "true"
            : localStorage.getItem("lume-theme") === "dark"
        )
          document.documentElement.dataset.theme = "dark";
      } catch {}
      // Match the production iOS treatment: let WebKit use the document background.
      if (
        /iPad|iPhone|iPod/.test(navigator.userAgent) ||
        (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1)
      ) {
        document.documentElement.dataset.appleTouch = "true";
        document.querySelector('meta[name="theme-color"]')?.remove();
      }
    </script>
  </head>
  <body
    class:list={["lume-next", { "is-reader": view !== "home" }]}
    data-image-missing={t.imageMissing}
    data-image-retry={t.imageRetry}
    data-enlarge={t.enlarge}
  >
    <a class="skip-link" href="#content">
      {t.skip}
    </a>
    {preview && (
      <div class="study-bar">
        <span>{t.previewNote}</span>
        <nav aria-label={t.appearance}>
          <a href={home} aria-current={view === "home" ? "page" : undefined}>
            {t.home}
          </a>
          <a href={read} aria-current={view === "article" ? "page" : undefined}>
            {t.reader}
          </a>
          <a href={lang === "hu" ? "/" : "/en/"}>{t.current} ↗</a>
        </nav>
      </div>
    )}
    <header class="next-header">
      <div class="masthead">
        <a class="wordmark" href={home} aria-label="Lume">
          LUME<span class="lume-point" aria-hidden="true"></span>
        </a>
        <div class="masthead-note">
          <span>{t.magazine}</span>
          <strong>{t.motto}</strong>
        </div>
        <MastheadClock lang={lang} />
      </div>
      <div class="navigation">
        <nav aria-label={t.nav}>
          {COLUMN_KEYS.map((key) => (
            <a
              href={designColumn(lang, key)}
              aria-current={active === key ? "page" : undefined}
            >
              {COLUMNS[key][lang].name}
            </a>
          ))}
          <a
            href={designWorkshop(lang)}
            aria-current={active === "workshop" ? "page" : undefined}
          >
            {t.workshopNav}
          </a>
          <a
            href={designCalendar(lang)}
            aria-current={active === "calendar" ? "page" : undefined}
          >
            {t.calendar}
          </a>
        </nav>
        <div class="utilities">
          <button class="search-trigger" data-open-search aria-label={t.search}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="10" cy="10" r="6.5" />
              <path d="m15 15 6 6" />
            </svg>
          </button>
          <a href={alternate} lang={lang === "hu" ? "en" : "hu"}>
            {lang === "hu" ? "EN" : "HU"}
          </a>
          <button
            class="theme-button"
            data-theme-toggle
            data-on={t.on}
            data-off={t.off}
          >
            <i aria-hidden="true"></i>
            <span>{t.off}</span>
          </button>
        </div>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>

    <footer class="next-footer">
      <div>
        <a class="footer-logo" href={home}>
          LUME<span aria-hidden="true">·</span>
        </a>
        <p>{t.magazine}</p>
      </div>
      <div>
        <h2>{t.footer}</h2>
        <p>{t.footerText}</p>
        <nav class="footer-links" aria-label={t.nav}>
          <a href={designAbout(lang)}>{t.about}</a>
          <a href={designArchive(lang)}>{t.archive}</a>
          {preview && (
            <a href={designHome(lang) + "404/"}>{t.notFoundPreview}</a>
          )}
          <a href={lang === "hu" ? "/rss.xml" : "/en/rss.xml"}>RSS ↗</a>
        </nav>
      </div>
    </footer>
    <dialog class="search-dialog" aria-labelledby="search-title">
      <div class="dialog-top">
        <h2 id="search-title">{t.search}</h2>
        <button data-dialog-close aria-label={t.close}>
          ×
        </button>
      </div>
      <label class="sr-only" for="design-query">
        {t.searchHint}
      </label>
      <input
        type="search"
        id="design-query"
        placeholder={t.searchHint}
        autocomplete="off"
      />
      <p class="search-empty" role="status" hidden>
        {t.searchEmpty}
      </p>
      <ul>
        {posts.map((post) => (
          <li
            data-search-entry
            data-search={`${post.data.title} ${post.data.description} ${post.data.seoTitle ?? ""}`}
          >
            <a href={designPost(post)}>
              <span class="eyebrow">
                {COLUMNS[post.data.column][lang].name}
              </span>
              <strong>{post.data.title}</strong>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </dialog>
    <dialog class="photo-dialog" aria-label={t.imageViewer}>
      <div class="dialog-top">
        <span>{t.imageHelp}</span>
        <button data-dialog-close aria-label={t.close}>
          ×
        </button>
      </div>
      <div data-viewer-credit></div>
    </dialog>
    <script>
      import "../../lib/lume-next";
    </script>
  </body>
</html>
