---
import { renderCoaxialModel, coaxialModelCSS, coaxialModelScript } from '../lib/coaxial-view.mjs';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<style is:inline set:html={coaxialModelCSS}/>
<Fragment set:html={renderCoaxialModel(lang)}/>
<script is:inline set:html={coaxialModelScript(lang)}/>
