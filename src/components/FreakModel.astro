---
import { renderFreakModel, freakCSS, freakScript } from '../lib/freak-view.mjs';
import { modelPageUrl, type Lang } from '../i18n/ui';
interface Props { lang: Lang; standalone?: boolean }
const { lang, standalone = false } = Astro.props;
---
<style is:inline set:html={freakCSS}/>
<Fragment set:html={renderFreakModel(lang, { standalone, openHref: modelPageUrl(lang, 'freak') })}/>
<script is:inline set:html={freakScript(lang)}/>
