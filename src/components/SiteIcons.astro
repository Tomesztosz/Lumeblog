---
// A new URL avoids the previous favicon's long-lived browser cache.
const version = "journal-monogram-1";
---

<link rel="icon" href={`/favicon-32.png?v=${version}`} type="image/png" sizes="32x32" />
<link rel="icon" href={`/favicon.svg?v=${version}`} type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${version}`} sizes="180x180" />
