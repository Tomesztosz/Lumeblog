---
import {
  COLUMN_KEYS,
  COLUMNS,
  UI,
  aboutUrl,
  archiveUrl,
  columnUrl,
  workshopUrl,
  type Lang,
} from '../i18n/ui';
import { CALENDAR_UI, calendarUrl } from '../lib/releases';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <span class="mark">LUME</span>
        <p>{t.tagline}</p>
      </div>
      <div class="foot-cols">
        <div>
          <h2>{t.footColumns}</h2>
          {COLUMN_KEYS.map((key) => <a href={columnUrl(lang, key)}>{COLUMNS[key][lang].name}</a>)}
        </div>
        <div>
          <h2>{t.footJournal}</h2>
          <a href={workshopUrl(lang)}>{t.workshop}</a>
          <a href={calendarUrl(lang)}>{CALENDAR_UI[lang].nav}</a>
          <a href={aboutUrl(lang)}>{t.about}</a>
          <a href={archiveUrl(lang)}>{t.archive}</a>
          <a href={lang === 'hu' ? '/rss.xml' : '/en/rss.xml'}>RSS</a>
        </div>
      </div>
    </div>
    <div class="foot-base">
      <span>{t.footCopy}</span>
      <span>{t.footPlace}</span>
    </div>
  </div>
</footer>
