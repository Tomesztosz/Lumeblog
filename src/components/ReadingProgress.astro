---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div
  class="reading-progress"
  data-reading-progress
  role="progressbar"
  aria-label={label}
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <span></span>
</div>

<script>
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const articleBody = document.querySelector<HTMLElement>('.article-body');
  const header = document.querySelector<HTMLElement>('.site-header');

  if (progress && articleBody) {
    let ticking = false;

    const measure = () => {
      if (header) {
        document.documentElement.style.setProperty('--lume-header-height', `${header.offsetHeight}px`);
      }

      const bodyTop = articleBody.getBoundingClientRect().top + window.scrollY;
      const bodyBottom = bodyTop + articleBody.offsetHeight;
      const start = bodyTop - (header?.offsetHeight ?? 0);
      const finish = Math.max(start + 1, bodyBottom - window.innerHeight * 0.55);
      const ratio = Math.min(1, Math.max(0, (window.scrollY - start) / (finish - start)));
      const percentage = Math.round(ratio * 100);

      progress.style.setProperty('--reading-progress', `${percentage}%`);
      progress.setAttribute('aria-valuenow', String(percentage));
      ticking = false;
    };

    const requestMeasure = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(measure);
    };

    window.addEventListener('scroll', requestMeasure, { passive: true });
    window.addEventListener('resize', requestMeasure, { passive: true });
    new ResizeObserver(requestMeasure).observe(articleBody);
    if (header) new ResizeObserver(requestMeasure).observe(header);
    measure();
  }
</script>

<style>
  .reading-progress {
    --reading-progress: 0%;
    position: fixed;
    z-index: 19;
    top: var(--lume-header-height, 70px);
    left: 0;
    width: 100%;
    height: 2px;
    pointer-events: none;
    background: transparent;
  }

  .reading-progress span {
    display: block;
    width: var(--reading-progress);
    height: 100%;
    background: var(--brass);
    box-shadow: 0 0 0 transparent;
    transition: width 80ms linear, background-color .7s ease, box-shadow .7s ease;
  }

  :global(body.dark) .reading-progress span {
    background: var(--lume-glow);
    box-shadow: 0 0 7px color-mix(in srgb, var(--lume-glow) 65%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress span { transition: none; }
  }
</style>
