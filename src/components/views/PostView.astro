---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostMedia from '../PostMedia.astro';
import StructuredData from '../StructuredData.astro';
import ReadingProgress from '../ReadingProgress.astro';
import ArticleToc from '../ArticleToc.astro';
import CopyArticleLink from '../CopyArticleLink.astro';
import RelatedPosts from '../RelatedPosts.astro';
import { COLUMNS, UI, aboutUrl, archiveUrl, columnUrl, formatDate, langBase, otherLang, workshopUrl } from '../../i18n/ui';
import { getRelatedPosts, getTranslation, minutesOf, urlOf, type Post } from '../../lib/posts';
import { ARTICLE_READING_EXPERIENCE } from '../../site';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const lang = post.data.lang;
const t = UI[lang];
const c = COLUMNS[post.data.column][lang];

const { Content, headings } = await render(post);
const readingExperience = ARTICLE_READING_EXPERIENCE;
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const showToc = readingExperience.enabled && readingExperience.tableOfContents && tocHeadings.length > 1;
const relatedPosts = readingExperience.enabled && readingExperience.relatedPosts
  ? await getRelatedPosts(post)
  : [];

/* A nyelvváltó a párcikkre visz, ha van; ha nincs, a másik nyelvű rovatra. */
const twin = await getTranslation(post, otherLang(lang));
const altUrl = twin ? urlOf(twin) : columnUrl(otherLang(lang), post.data.column);

const canonical = new URL(urlOf(post), Astro.site).href;
const columnHref = new URL(columnUrl(lang, post.data.column), Astro.site).href;
const organizationId = new URL('/#organization', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const coverImage = post.data.cover
  ? await getImage({
      src: post.data.cover.src,
      width: Math.min(1200, post.data.cover.src.width),
      format: 'webp',
    })
  : undefined;
const socialImage = coverImage && post.data.cover ? {
  src: coverImage.src,
  width: Number(coverImage.attributes.width),
  height: Number(coverImage.attributes.height),
  alt: post.data.cover.alt,
} : undefined;
const updated = post.data.updated;
if (updated && (updated < post.data.date || updated > new Date())) {
  throw new Error(`Invalid article update date: ${post.id}`);
}

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${canonical}#article`,
      headline: post.data.title,
      description: post.data.seoDescription ?? post.data.description,
      datePublished: post.data.date.toISOString(),
      ...(updated ? { dateModified: updated.toISOString() } : {}),
      author: { '@type': 'Organization', '@id': organizationId, name: 'Lume', url: new URL('/', Astro.site).href },
      isAccessibleForFree: true,
      inLanguage: lang === 'hu' ? 'hu-HU' : 'en-GB',
      articleSection: c.name,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      isPartOf: { '@id': websiteId },
      publisher: { '@id': organizationId },
      ...(socialImage ? { image: {
        '@type': 'ImageObject',
        url: new URL(socialImage.src, Astro.site).href,
        width: socialImage.width,
        height: socialImage.height,
        caption: socialImage.alt,
      } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Lume',
          item: new URL(lang === 'hu' ? '/' : '/en/', Astro.site).href,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: c.name,
          item: columnHref,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: post.data.title,
          item: canonical,
        },
      ],
    },
  ],
};
---

<Base
  lang={lang}
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  altUrl={altUrl}
  hasTranslation={Boolean(twin)}
  active={post.data.column}
  ogType="article"
  socialImage={socialImage}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta property="article:section" content={c.name} />
    <StructuredData data={articleStructuredData} />
  </Fragment>

  <article class="article">
    {
      readingExperience.enabled && readingExperience.progress && (
        <ReadingProgress label={t.articleProgress} />
      )
    }

    <div class="wrap wrap-narrow article-intro">
      <header class="article-head">
        <nav class="article-breadcrumb mono" aria-label={t.breadcrumb}>
          <a href={langBase(lang)}>Lume</a><span aria-hidden="true">/</span>
          <a href={columnUrl(lang, post.data.column)}>{c.name}</a>
        </nav>
        <div class="post-meta">
          <a class="tag" href={columnUrl(lang, post.data.column)}>{c.name}</a>
          <time class="dotsep mono" datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
          <span class="dotsep mono">{t.minutes(minutesOf(post))}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="standfirst">{post.data.description}</p>
        <p class="article-byline mono">{t.writtenBy} <a rel="author" href={aboutUrl(lang)}>Lume</a>
          {updated && <> · {t.updatedOn} <time datetime={updated.toISOString()}>{formatDate(updated, lang)}</time></>}
        </p>
      </header>

      <PostMedia column={post.data.column} cover={post.data.cover} variant="lead" />
    </div>

    <div class="wrap article-reading-layout">
      {showToc && <ArticleToc headings={tocHeadings} label={t.articleContents} />}

      <div class="article-reading-main">
        <div class="article-body">
          <Content />
        </div>

        {
          post.data.sources.length > 0 && (
            <aside class="sources">
              <h2>{t.sources}</h2>
              <ol>
                {post.data.sources.map((s) => (
                  <li>
                    {s.url ? (
                      <a href={s.url} rel="noopener noreferrer" target="_blank">
                        {s.label}
                      </a>
                    ) : (
                      s.label
                    )}
                  </li>
                ))}
              </ol>
            </aside>
          )
        }

        {
          readingExperience.enabled && readingExperience.copyLink && (
            <div class="article-copy-link">
              <CopyArticleLink label={t.copyLink} copied={t.linkCopied} error={t.copyLinkError} />
            </div>
          )
        }

        <nav class="article-nav">
          <a href={columnUrl(lang, post.data.column)}>← {t.backToColumn}</a>
          <a href={archiveUrl(lang)}>{t.archive}</a>
          {post.data.model && <a href={`${workshopUrl(lang)}#${post.data.translationKey ?? post.id.split('/').pop()}`}>{t.workshop} →</a>}
        </nav>
      </div>
    </div>

    {
      readingExperience.enabled && readingExperience.relatedPosts && (
        <div class="wrap">
          <RelatedPosts
            lang={lang}
            posts={relatedPosts}
            title={t.continueReading}
            note={t.continueReadingNote}
          />
        </div>
      )
    }
  </article>
</Base>

<style>
  .article-breadcrumb { display: flex; gap: 10px; margin-bottom: 26px; font-size: 11px; color: var(--ink-soft); }
  .article-breadcrumb a, .article-byline a { text-underline-offset: 4px; }
  .article-byline { font-size: 11px; color: var(--ink-soft); margin: 20px 0 0; }
  .article-head .tag {
    text-decoration: none;
  }

  .article-copy-link {
    display: flex;
    justify-content: flex-end;
    margin-top: 30px;
  }
</style>
