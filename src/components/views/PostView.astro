---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostMedia from '../PostMedia.astro';
import { COLUMNS, UI, columnUrl, formatDate, otherLang } from '../../i18n/ui';
import { getTranslation, minutesOf, urlOf, type Post } from '../../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const lang = post.data.lang;
const t = UI[lang];
const c = COLUMNS[post.data.column][lang];

const { Content } = await render(post);

/* A nyelvváltó a párcikkre visz, ha van; ha nincs, a másik nyelvű rovatra. */
const twin = await getTranslation(post, otherLang(lang));
const altUrl = twin ? urlOf(twin) : columnUrl(otherLang(lang), post.data.column);
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  altUrl={altUrl}
  active={post.data.column}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
  </Fragment>

  <article class="article">
    <div class="wrap wrap-narrow">
      <header class="article-head">
        <div class="post-meta">
          <a class="tag" href={columnUrl(lang, post.data.column)}>{c.name}</a>
          <span class="dotsep mono">{formatDate(post.data.date, lang)}</span>
          <span class="dotsep mono">{t.minutes(minutesOf(post))}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="standfirst">{post.data.description}</p>
      </header>

      <PostMedia column={post.data.column} cover={post.data.cover} variant="lead" />

      <div class="article-body">
        <Content />
      </div>

      {
        post.data.sources.length > 0 && (
          <aside class="sources">
            <h4>{t.sources}</h4>
            <ol>
              {post.data.sources.map((s) => (
                <li>
                  {s.url ? (
                    <a href={s.url} rel="noopener noreferrer" target="_blank">
                      {s.label}
                    </a>
                  ) : (
                    s.label
                  )}
                </li>
              ))}
            </ol>
          </aside>
        )
      }

      <nav class="article-nav">
        <a href={columnUrl(lang, post.data.column)}>← {t.backToColumn}</a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .article-head .tag {
    text-decoration: none;
  }
</style>
