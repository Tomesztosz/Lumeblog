---
import StructuredData from "./StructuredData.astro";
import SiteIcons from "./SiteIcons.astro";
import { UI } from "../i18n/ui";
import { LAUNCHED, INSTAGRAM_URL } from "../site";
import { resolveSeo, websiteSchema, type SeoHeadProps } from '../lib/seo';
import serifLatin from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import serifExtended from "@fontsource-variable/fraunces/files/fraunces-latin-ext-opsz-normal.woff2?url";
import sansLatin from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url";
import sansExtended from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-ext-wght-normal.woff2?url";

interface Props extends SeoHeadProps {}

const {
  lang,
  hasTranslation = true,
  ogType = "website",
} = Astro.props;
const t = UI[lang];

const seo = resolveSeo({ ...Astro.props, path:Astro.url.pathname, site:Astro.site!, launched:LAUNCHED,
  fallbackTitle:t.siteTitle, fallbackDescription:t.siteDescription, fallbackAlt:t.tagline });
const {title:pageTitle,description:pageDescription,canonical,indexable} = seo;
const siteStructuredData = websiteSchema(Astro.site!, t.siteDescription, [INSTAGRAM_URL]);
---

<meta charset="UTF-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, viewport-fit=cover"
/>
{[
  serifLatin,
  sansLatin,
  ...(lang === "hu" ? [serifExtended, sansExtended] : []),
].map((font) => (
  <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
))}
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
{/* Amíg nincs domain és első cikk, ne indexelje senki. Kapcsoló: src/site.ts */}
<meta
  name="robots"
  content={seo.robots}
/>
{indexable && <link rel="canonical" href={canonical} />}
{seo.alternates.map(({lang:language,url}) => <link rel="alternate" hreflang={language} href={url} />)}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Lume" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === "hu" ? "hu_HU" : "en_GB"} />
{hasTranslation && (
  <meta
    property="og:locale:alternate"
    content={lang === "hu" ? "en_GB" : "hu_HU"}
  />
)}
<meta property="og:image" content={seo.image.src} />
<meta property="og:image:width" content={seo.image.width} />
<meta property="og:image:height" content={seo.image.height} />
<meta property="og:image:alt" content={seo.image.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={seo.image.src} />
<meta name="twitter:image:alt" content={seo.image.alt} />

<StructuredData data={siteStructuredData} />

<SiteIcons />

<link
  rel="alternate"
  type="application/rss+xml"
  title={t.siteTitle}
  href={lang === "hu" ? "/rss.xml" : "/en/rss.xml"}
/>

<slot />
