---
import ColumnView from '../../components/views/ColumnView.astro';
import { COLUMN_KEYS, COLUMNS } from '../../i18n/ui';

export function getStaticPaths() {
  return COLUMN_KEYS.map((key) => ({
    params: { column: COLUMNS[key].hu.slug },
    props: { key },
  }));
}

const { key } = Astro.props;
---

<ColumnView lang="hu" column={key} />
