---
import ColumnView from '../../../components/journal/JournalPage.astro';
import { COLUMN_KEYS, COLUMNS } from '../../../i18n/ui';

export function getStaticPaths() {
  return COLUMN_KEYS.map((key) => ({
    params: { column: COLUMNS[key].en.slug },
    props: { key },
  }));
}

const { key } = Astro.props;
---

<ColumnView view="column" lang="en" column={key} />
