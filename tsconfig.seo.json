{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["astro/client"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/lib/seo.ts",
    "src/lib/calendar-seo.ts",
    "src/lib/journal-metadata.ts"
  ]
}
