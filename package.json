{
  "name": "lume",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run check:calendar && astro build && node scripts/check-calendar-build.mjs && node scripts/secure-build.mjs && npm run check:seo && npm run check:llms && npm run check:security && npm run check:journal",
    "check:llms": "node --experimental-strip-types --test scripts/llms.test.mjs && node --experimental-strip-types scripts/check-llms.mjs",
    "check:llms:http": "node --experimental-strip-types scripts/check-llms.mjs --production",
    "llms:find": "node scripts/find-llms.mjs",
    "check:calendar": "node --test scripts/calendar.test.mjs scripts/calendar-events.test.mjs && node scripts/check-calendar.mjs",
    "calendar:refresh": "node --max-http-header-size=65536 scripts/refresh-calendar-events.mjs",
    "calendar:migrate": "node scripts/migrate-calendar-events.mjs",
    "radar:check": "node --max-http-header-size=65536 scripts/check-radar.mjs",
    "check:seo": "tsc --project tsconfig.seo.json && node --experimental-strip-types --test scripts/seo-html.test.mjs scripts/seo-core.test.mjs scripts/content-graph.test.mjs scripts/seo-measurement.test.mjs scripts/seo-measure-cli.test.mjs && node --experimental-strip-types scripts/check-content-graph.mjs && node scripts/check-seo.mjs && node scripts/check-content-build.mjs",
    "seo:editorial": "node --experimental-strip-types scripts/check-content-graph.mjs",
    "seo:measure": "node scripts/seo-measure.mjs",
    "check:content:browser": "node scripts/check-content-browser.mjs",
    "check:seo:browser": "node scripts/check-seo-browser.mjs",
    "check:seo:http": "node scripts/check-seo-http.mjs",
    "check:security": "node --test scripts/security.test.mjs && node scripts/check-security.mjs",
    "check:journal": "node --test scripts/design-models.test.mjs scripts/design-release.test.mjs && node scripts/check-journal-build.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/markdown-remark": "^7.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "parse5": "^7.3.0",
    "typescript": "6.0.3",
    "yaml": "^2.9.0"
  }
}
