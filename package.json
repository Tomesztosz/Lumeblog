{
  "name": "lume",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run check:calendar && astro build && node scripts/check-calendar-build.mjs && node scripts/secure-build.mjs && npm run check:seo && npm run check:security && npm run check:journal",
    "check:calendar": "node --test scripts/calendar.test.mjs && node scripts/check-calendar.mjs",
    "radar:check": "node --max-http-header-size=65536 scripts/check-radar.mjs",
    "check:seo": "node --test scripts/seo-html.test.mjs && node scripts/check-seo.mjs",
    "check:security": "node --test scripts/security.test.mjs && node scripts/check-security.mjs",
    "check:journal": "node --test scripts/design-models.test.mjs scripts/design-release.test.mjs && node scripts/check-journal-build.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/markdown-remark": "^7.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "parse5": "^8.0.1",
    "yaml": "^2.9.0"
  }
}
